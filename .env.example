# ═══════════════════════════════════════════════════
# Hungry Ape — Variables de entorno para producción
# Copia este archivo como .env.local y completa los valores
# En Vercel: Settings → Environment Variables
# ═══════════════════════════════════════════════════

# ─── Supabase ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Crons (Vercel Cron envía Authorization: Bearer <CRON_SECRET>) ───
# OBLIGATORIO en producción: sin esto los crons se niegan a correr.
CRON_SECRET=

# ─── App URL ───────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://ape.teolabs.app

# ─── Pagos online de los locales (Mercado Pago Marketplace, plan Pro) ──
# App de marketplace en https://www.mercadopago.cl/developers (Client ID / Secret) y como
# "URL de redireccionamiento" registra: <NEXT_PUBLIC_APP_URL>/api/payments/connect/callback
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Comisión opcional de Hungry Ape sobre cada pago online, en % (0 a 10). Vacío = 0.
MP_MARKETPLACE_FEE_PERCENT=
# Clave para cifrar los tokens de cada local (64 caracteres hex):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENTS_ENC_KEY=
# Opcional: secreto del webhook de esta app si es distinto al de las suscripciones
MP_MARKETPLACE_WEBHOOK_SECRET=

# ─── Mercado Pago ──────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# ─── Zoho Mail SMTP ────────────────────────────────
ZOHO_SMTP_USER=hola@teolabs.app
ZOHO_SMTP_PASS=

# ─── Avisos "tu pedido está listo" · Web Push (gratis, sin límite) ───
# Genera las llaves con:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@teolabs.app

# ─── Avisos por WhatsApp (Cloud API de Meta) ───────────────────────
# El cliente abre el chat (ventana de 24 h) y respondemos dentro de ella: sin costo por mensaje.
# NEXT_PUBLIC_WHATSAPP_NUMBER: solo dígitos con código de país, ej. 56912345678
NEXT_PUBLIC_WHATSAPP_NUMBER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# ─── Google AI (Genkit) ────────────────────────────
GOOGLE_GENAI_API_KEY=
